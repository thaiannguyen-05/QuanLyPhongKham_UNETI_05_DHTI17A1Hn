@model QuanLyPhongKham_UNETI_05_DHTI17A1Hn.Modules.Schedule.Models.ScheduleIndexViewModel
@{ ViewData["Title"] = "Tra cứu lịch khám"; }
<h1 class="h3 text-primary fw-bold mb-1">Tra cứu lịch khám</h1>
<p class="text-muted small">Chỉ hiển thị lịch Còn nhận đăng ký, chưa diễn ra và còn chỗ</p>
<div class="card shadow-sm border-0 mb-3"><div class="card-body">
<form method="get" asp-action="Search"><div class="row g-2">
<div class="col-md-4"><select name="DoctorId" asp-items="Model.DoctorList" class="form-select"><option value="">-- Tất cả bác sĩ --</option></select></div>
<div class="col-md-4"><select name="SpecialtyId" asp-items="Model.SpecialtyList" class="form-select"><option value="">-- Tất cả chuyên khoa --</option></select></div>
<div class="col-md-2"><input type="date" name="Date" value="@(Model.Date?.ToString("yyyy-MM-dd"))" class="form-control" /></div>
<div class="col-md-2 d-flex gap-2"><button class="btn btn-primary">Tìm</button><a asp-action="Search" class="btn btn-outline-secondary">Reset</a></div>
</div></form>
</div></div>
<partial name="_ScheduleTable" model="Model" />
