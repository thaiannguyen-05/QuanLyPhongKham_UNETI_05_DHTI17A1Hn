@model QuanLyPhongKham_UNETI_05_DHTI17A1Hn.Modules.Account.Models.AccountFormViewModel
@{
    ViewData["Title"] = "Cập nhật tài khoản";
    ViewData["PasswordHint"] = "Để trống nếu không muốn đổi mật khẩu.";
}

<h1 class="h3 mb-3">Cập nhật tài khoản</h1>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input asp-for="Id" type="hidden" />
            <partial name="_AccountForm" />
            <button type="submit" class="btn btn-primary">Lưu</button>
            <a class="btn btn-secondary" asp-action="Index">Hủy</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
