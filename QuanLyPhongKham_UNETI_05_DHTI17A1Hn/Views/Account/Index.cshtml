@model QuanLyPhongKham_UNETI_05_DHTI17A1Hn.Modules.Account.Models.AccountIndexViewModel
@{
    ViewData["Title"] = "Quản lý tài khoản";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Quản lý tài khoản</h1>
    <a class="btn btn-primary" asp-action="Create">Thêm tài khoản</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã</th>
                    <th>Tên đăng nhập</th>
                    <th>Họ tên</th>
                    <th>Email</th>
                    <th>Vai trò</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var account in Model.Accounts)
            {
                <tr>
                    <td>@account.Id</td>
                    <td>@account.Username</td>
                    <td>@account.FullName</td>
                    <td>@(account.Email ?? "-")</td>
                    <td>@account.Role</td>
                    <td>@account.Status</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@account.Id">Sửa</a>
                        <form class="d-inline" asp-action="SetLock" asp-route-id="@account.Id" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="isLocked" value="@(account.Status != AccountStatus.Locked)" />
                            <button class="btn btn-sm btn-outline-secondary" type="submit">
                                @(account.Status == AccountStatus.Locked ? "Mở khóa" : "Khóa")
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
