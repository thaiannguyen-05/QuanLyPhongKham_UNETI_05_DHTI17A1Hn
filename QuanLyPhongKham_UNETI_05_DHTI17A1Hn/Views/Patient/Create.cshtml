@model QuanLyPhongKham_UNETI_05_DHTI17A1Hn.Modules.Patient.Models.PatientFormViewModel
@{
    ViewData["Title"] = "Thêm bệnh nhân mới";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0 text-primary fw-bold">Thêm bệnh nhân mới</h1>
        <small class="text-muted">Nhập hồ sơ bệnh nhân, có thể tạo tài khoản đăng nhập kèm</small>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">
        &larr; Quay lại danh sách
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <partial name="_PatientForm" model="Model" />

            <div class="mt-4 pt-3 border-top d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4">
                    💾 Lưu bệnh nhân
                </button>
                <a class="btn btn-light" asp-action="Index">Hủy bỏ</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
