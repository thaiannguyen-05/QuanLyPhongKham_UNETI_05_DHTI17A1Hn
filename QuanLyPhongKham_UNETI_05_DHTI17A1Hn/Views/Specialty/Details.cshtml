@model QuanLyPhongKham_UNETI_05_DHTI17A1Hn.Modules.Specialty.Models.SpecialtyDetailViewModel
@{
    ViewData["Title"] = "Chi tiết chuyên khoa";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Chi tiết chuyên khoa</h1>
    <a class="btn btn-secondary" asp-action="Index">Quay lại</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Mã</dt>
            <dd class="col-sm-9">@Model.Id</dd>
            <dt class="col-sm-3">Tên chuyên khoa</dt>
            <dd class="col-sm-9">@Model.Name</dd>
            <dt class="col-sm-3">Mô tả</dt>
            <dd class="col-sm-9">@(Model.Description ?? "-")</dd>
            <dt class="col-sm-3">Số bác sĩ</dt>
            <dd class="col-sm-9">@Model.DoctorCount</dd>
            <dt class="col-sm-3">Trạng thái</dt>
            <dd class="col-sm-9">@Model.Status</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Sửa</a>
    <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Xóa</a>
</div>
