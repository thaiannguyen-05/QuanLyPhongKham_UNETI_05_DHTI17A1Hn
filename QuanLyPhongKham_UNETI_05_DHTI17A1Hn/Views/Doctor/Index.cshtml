@model QuanLyPhongKham_UNETI_05_DHTI17A1Hn.Modules.Doctor.Models.DoctorIndexViewModel
@using QuanLyPhongKham_UNETI_05_DHTI17A1Hn.Enums
@{
    ViewData["Title"] = "Quản lý Bác sĩ";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-0 text-primary fw-bold">👨‍⚕️ Quản lý Bác sĩ</h1>
        <p class="text-muted mb-0 small">Danh sách bác sĩ, chuyên môn và thông tin khám chữa bệnh</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        ➕ Thêm bác sĩ mới
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        ✅ @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        ⚠️ @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Bộ lọc tìm kiếm & sắp xếp -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-light py-3">
        <h6 class="mb-0 fw-semibold text-secondary">🔍 Bộ lọc & Tìm kiếm</h6>
    </div>
    <div class="card-body">
        <form method="get" asp-action="Index">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Từ khóa</label>
                    <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Tên, SĐT, email..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Chuyên khoa</label>
                    <select name="SpecialtyId" asp-items="Model.SpecialtyList" class="form-select">
                        <option value="">-- Tất cả chuyên khoa --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">Giới tính</label>
                    <select name="Gender" class="form-select">
                        <option value="">-- Tất cả --</option>
                        <option value="Nam" selected="@(Model.Gender == "Nam")">Nam</option>
                        <option value="Nữ" selected="@(Model.Gender == "Nữ")">Nữ</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">Trạng thái</label>
                    <select name="Status" class="form-select">
                        <option value="">-- Tất cả --</option>
                        <option value="Working" selected="@(Model.Status == DoctorStatus.Working)">Đang làm việc</option>
                        <option value="OnLeave" selected="@(Model.Status == DoctorStatus.OnLeave)">Nghỉ phép</option>
                        <option value="Inactive" selected="@(Model.Status == DoctorStatus.Inactive)">Ngừng làm việc</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">Phí từ (VNĐ)</label>
                    <input type="number" name="MinFee" value="@Model.MinFee" class="form-control" step="any" min="0" placeholder="Từ..." />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">Phí đến (VNĐ)</label>
                    <input type="number" name="MaxFee" value="@Model.MaxFee" class="form-control" step="any" min="0" placeholder="Đến..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Sắp xếp theo</label>
                    <select name="SortBy" class="form-select">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.SortBy))">Mặc định (Mới nhất)</option>
                        <option value="name_asc" selected="@(Model.SortBy == "name_asc")">Họ tên (A -> Z)</option>
                        <option value="name_desc" selected="@(Model.SortBy == "name_desc")">Họ tên (Z -> A)</option>
                        <option value="fee_asc" selected="@(Model.SortBy == "fee_asc")">Phí khám (Thấp -> Cao)</option>
                        <option value="fee_desc" selected="@(Model.SortBy == "fee_desc")">Phí khám (Cao -> Thấp)</option>
                        <option value="exp_desc" selected="@(Model.SortBy == "exp_desc")">Kinh nghiệm (Nhiều nhất)</option>
                        <option value="exp_asc" selected="@(Model.SortBy == "exp_asc")">Kinh nghiệm (Ít nhất)</option>
                    </select>
                </div>
                <div class="col-md-7 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary">
                        🔍 Lọc dữ liệu
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        🔄 Đặt lại
                    </a>
                    <span class="text-muted small ms-auto align-self-center">
                        Tổng cộng: <strong>@Model.TotalItems</strong> bác sĩ
                    </span>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Bảng danh sách bác sĩ -->
<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" style="width: 60px;">Mã</th>
                    <th scope="col">Họ và tên</th>
                    <th scope="col">Chuyên khoa</th>
                    <th scope="col">Trình độ</th>
                    <th scope="col" class="text-center">Kinh nghiệm</th>
                    <th scope="col" class="text-end">Phí khám</th>
                    <th scope="col">Số ĐT</th>
                    <th scope="col" class="text-center">Trạng thái</th>
                    <th scope="col" class="text-center" style="width: 160px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Doctors.Any())
                {
                    foreach (var doc in Model.Doctors)
                    {
                        <tr>
                            <td class="text-muted fw-bold">#@doc.Id</td>
                            <td>
                                <div class="fw-bold text-dark">@doc.FullName</div>
                                @if (!string.IsNullOrEmpty(doc.Gender))
                                {
                                    <span class="badge bg-light text-secondary border small">@doc.Gender</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                    @doc.SpecialtyName
                                </span>
                            </td>
                            <td>
                                <small class="text-muted">@(doc.Qualification ?? "--")</small>
                            </td>
                            <td class="text-center">
                                @doc.YearsOfExperience năm
                            </td>
                            <td class="text-end fw-semibold text-primary">
                                @doc.ConsultationFee.ToString("N0") VNĐ
                            </td>
                            <td>
                                <small>@(doc.Phone ?? "--")</small>
                            </td>
                            <td class="text-center">
                                @switch (doc.Status)
                                {
                                    case DoctorStatus.Working:
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Đang làm việc</span>
                                        break;
                                    case DoctorStatus.OnLeave:
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Nghỉ phép</span>
                                        break;
                                    case DoctorStatus.Inactive:
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Ngừng làm việc</span>
                                        break;
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Details" asp-route-id="@doc.Id" class="btn btn-outline-info" title="Xem chi tiết">
                                        👁️
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@doc.Id" class="btn btn-outline-warning" title="Chỉnh sửa">
                                        ✏️
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@doc.Id" class="btn btn-outline-danger" title="Xóa bác sĩ">
                                        🗑️
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <p class="mb-1 fs-5">🔍 Không tìm thấy bác sĩ nào</p>
                            <small>Hãy thử thay đổi điều kiện tìm kiếm hoặc thêm bác sĩ mới.</small>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Phân trang -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="text-muted small">
                Trang <strong>@Model.CurrentPage</strong> / <strong>@Model.TotalPages</strong>
            </span>
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-CurrentPage="@(Model.CurrentPage - 1)"
                           asp-route-SearchTerm="@Model.SearchTerm"
                           asp-route-SpecialtyId="@Model.SpecialtyId"
                           asp-route-Gender="@Model.Gender"
                           asp-route-Status="@Model.Status"
                           asp-route-MinFee="@Model.MinFee"
                           asp-route-MaxFee="@Model.MaxFee"
                           asp-route-SortBy="@Model.SortBy">
                            &laquo; Trước
                        </a>
                    </li>

                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-CurrentPage="@p"
                               asp-route-SearchTerm="@Model.SearchTerm"
                               asp-route-SpecialtyId="@Model.SpecialtyId"
                               asp-route-Gender="@Model.Gender"
                               asp-route-Status="@Model.Status"
                               asp-route-MinFee="@Model.MinFee"
                               asp-route-MaxFee="@Model.MaxFee"
                               asp-route-SortBy="@Model.SortBy">
                                @p
                            </a>
                        </li>
                    }

                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-CurrentPage="@(Model.CurrentPage + 1)"
                           asp-route-SearchTerm="@Model.SearchTerm"
                           asp-route-SpecialtyId="@Model.SpecialtyId"
                           asp-route-Gender="@Model.Gender"
                           asp-route-Status="@Model.Status"
                           asp-route-MinFee="@Model.MinFee"
                           asp-route-MaxFee="@Model.MaxFee"
                           asp-route-SortBy="@Model.SortBy">
                            Sau &raquo;
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
